# Copy to .env and replace every CHANGE_ME value before use.

# Django
EVITRACK_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ALLOWED_HOSTS=localhost,127.0.0.1
# Local Docker runs over plain HTTP, so keep this False. Behind a real TLS
# terminator set it to True (the production default).
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# PostgreSQL (used by docker-compose; DATABASE_URL is built from these)
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Host port for the nginx container
HTTP_PORT=8080

# Non-Docker runs (manage.py, Celery on the host): point at local services
# DEBUG=1
# USE_SQLITE=1
# DATABASE_URL=postgres://evitrack:CHANGE_ME_DB_PASSWORD@localhost:5432/evitrack
# REDIS_URL=redis://localhost:6379/1
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# EVIDENCE_ROOT=/absolute/path/outside/the/web/root
# EVIDENCE_USE_X_ACCEL=False

# Email (development uses the console backend; set real SMTP values for production)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=CHANGE_ME
# EMAIL_HOST_PASSWORD=CHANGE_ME
